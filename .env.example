# ════════════════════════════════════════
#  Makari Islamic TV — Environment Config
# ════════════════════════════════════════

# ── PostgreSQL (required) ────────────────────────────────────
# Get this from Render → your PostgreSQL service → Connect → "External Database URL"
# Format: postgresql://USER:PASSWORD@HOST:PORT/DATABASE
DATABASE_URL=postgresql://makari_admin:yourpassword@dpg-xxxx.oregon-postgres.render.com/makari_tv

# ── Security ─────────────────────────────────────────────────
# Generate with: python -c "import secrets; print(secrets.token_hex(32))"
# Required in production — the app refuses to start without it.
SECRET_KEY=change-this-to-a-long-random-string-minimum-32-characters

# ── First admin account ──────────────────────────────────────
# The app will NOT create any default/predictable admin account.
# Set these once to bootstrap your own admin login, then the app
# (and GET/POST /api/auth/setup) will create it automatically.
# Password must be at least 8 characters.
ADMIN_EMAIL=you@example.com
ADMIN_PASSWORD=change-this-to-a-strong-password

# ── CORS ─────────────────────────────────────────────────────
# Comma-separated list of frontend origins allowed to call this API.
# Leave unset only for local development.
ALLOWED_ORIGINS=https://your-frontend-domain.com

# ── App ──────────────────────────────────────────────────────
ENVIRONMENT=production
