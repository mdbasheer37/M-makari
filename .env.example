# ── Database ─────────────────────────────────────────────────
# SQLite for local development (default - no setup needed)
DATABASE_URL=sqlite:///./makari_tv.db

# PostgreSQL for production on Render (uncomment when deploying)
# DATABASE_URL=postgresql://user:password@host:5432/makari_tv

# ── Security ─────────────────────────────────────────────────
# Change this to a long random string in production!
# Generate one: python -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=change-this-to-a-random-secret-key-min-32-chars

# ── Environment ───────────────────────────────────────────────
ENVIRONMENT=development

# ── Media ────────────────────────────────────────────────────
MEDIA_BASE_URL=http://localhost:8000/media
MAX_UPLOAD_SIZE_MB=500
